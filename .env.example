# XHS Pain Miner 环境配置

# ========== 必填 ==========
# OpenAI API Key (用于 GPT-4o 多模态分析)
OPENAI_API_KEY=sk-your-key-here

# ========== 可选 ==========
# 备选 LLM: 也可使用 DeepSeek / Claude
# LLM_PROVIDER=openai  # openai | deepseek | claude
# LLM_MODEL=gpt-4o     # gpt-4o | deepseek-chat | claude-3-5-sonnet

# 数据采集配置
XHS_PROXY=              # 代理地址（可选）
XHS_COOKIE=             # 小红书 Cookie（可选，提高采集稳定性）

# 分析配置
MAX_NOTES=200           # 最大采集笔记数
MAX_COMMENTS=500        # 最大采集评论数
ANALYSIS_LANGUAGE=zh    # 分析语言

# Web 仪表盘
WEB_HOST=0.0.0.0
WEB_PORT=8080
