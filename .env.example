# XHS Pain Miner 配置样例
#
# 复制为 .env 后按需修改：cp .env.example .env
# 所有项都是可选的，只有 LLM_API_KEY 在真正调用模型时才必需。
# 优先级：环境变量 > .env > 内置默认值。

# ==================== LLM（文本分析）====================
# 用于：痛点簇命名、竞品归纳、实现难度评估
LLM_API_KEY=sk-your-key-here

# 协议三选一：chat | responses | messages
#   chat      OpenAI Chat Completions —— 兼容 DeepSeek / Qwen / Kimi / GLM / OpenAI
#   responses OpenAI Responses API
#   messages  Anthropic Messages API
LLM_PROTOCOL=chat

# 默认是 DeepSeek，成本约为 GPT-4o 的 1/20
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 切换示例（三选一，取消对应行的注释）：
# OpenAI      LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# Qwen        LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# Claude      LLM_PROTOCOL=messages   LLM_MODEL=claude-sonnet-5   LLM_BASE_URL=（留空使用官方端点）

# LLM_TEMPERATURE=0.3
# LLM_MAX_CONCURRENCY=4

# ==================== VLM（图片分析，--deep）====================
# 不配置则继承上面的 LLM 设置。
# 注意：DeepSeek 没有视觉能力，跑 --deep 时必须单独配置一个多模态模型。
# VLM_MODEL=qwen-vl-max
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_API_KEY=sk-your-vl-key-here
#
# 或使用 GPT-4o：
# VLM_MODEL=gpt-4o
# VLM_BASE_URL=https://api.openai.com/v1
# VLM_API_KEY=sk-your-openai-key-here

# 图片长边压缩到该像素值后才上传，直接决定 VLM 的 token 消耗
# VLM_IMAGE_MAX_EDGE=512
# 每篇笔记最多分析几张图
# VLM_MAX_IMAGES_PER_NOTE=3
# 单次运行的 VLM 调用上限（留空表示只预告成本，不设硬上限）
# MAX_VLM_CALLS=200

# ==================== Embedding（向量化）====================
# local 是本项目的降本关键：本地模型零 API 成本
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 若改用远程 API：
# EMBEDDING_PROVIDER=api
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx

# ==================== 采集后端 ====================
# fixture 内置脱敏样例数据（默认，不联网）
# plugin  加载你本机自备的采集器（见 docs/collector-plugin.md）
# mcp     对接本机运行的 xiaohongshu-mcp 服务（见 docs/collector-mcp.md）
COLLECTOR_BACKEND=fixture

# COLLECTOR_BACKEND=plugin 时，指向你的采集器模块或 .py 文件
# 两个名字都可用：XHS_COLLECTOR_PLUGIN（推荐，不易与其它工具冲突）或 COLLECTOR_PLUGIN
# XHS_COLLECTOR_PLUGIN=/absolute/path/to/my_xhs_backend.py

# ---- COLLECTOR_BACKEND=mcp 时有效 ------------------------------------------
# 服务地址。默认值就是 xiaohongshu-mcp 的默认监听地址；该服务只监听本机，
# 不要指向公网地址 —— 登录态交给远端服务会超出本工具的定位。
# XHS_MCP_URL=http://127.0.0.1:18060

# 服务端启用了鉴权（AUTH_TOKEN）时才需要填，值与服务端保持一致。
# 只保存在本机，与 LLM 的 API Key 同级对待。
# XHS_MCP_TOKEN=

# 单次请求超时（秒）。该服务用浏览器自动化取数据，加载全部评论时几十秒是常态；
# 调小会把"慢"误报成"采集失败"。默认 120 秒。
# XHS_MCP_TIMEOUT=120

# 注意：本后端**没有 cookie 配置项**。登录态由 xiaohongshu-mcp 自己保管
# （用它自带的登录工具扫码登录），本程序不接触、也不需要你的 cookie。

# ==================== 竞品调研 ====================
# 是否调研「这个方向有没有人做过」。关闭后「竞品空白度」因子按中性值 0.5 计算
# —— 注意不是按满分算：没查过不等于没人做过。
RESEARCH_ENABLED=true

# GitHub Token。匿名调用搜索接口约 10 次/分钟，簇多时必然被限流。
# 被限流的簇会退化成"调研失败"并按中性值处理，不会被误当成"没有竞品"。
# GITHUB_TOKEN=ghp_xxx

# 最多对多少个痛点簇做竞品调研（按提及量降序）。超出的簇按中性值处理。
# RESEARCH_MAX_CLUSTERS=12

# 每个痛点簇最多发几条检索词。每条都是一次真实的平台请求：
# GitHub 匿名额度约 10 次/分钟、App Store 无官方限额说明，
# 12 个簇 × 4 条 = 48 次请求，匿名额度下仅等待就约 5 分钟。调小可以更快跑完。
# RESEARCH_MAX_QUERIES_PER_CLUSTER=4

# App Store 调研的区。中文小工具用 cn；面向海外用户可改成 us。
# APPSTORE_COUNTRY=cn

# ==================== 机会分权重 ====================
# 五个因子，会自动归一化。调高某一项即表示"我更看重这个维度"。
# 全部用默认值即可；调完后卡片上的分数构成会随之变化，可逐项对照。
# WEIGHT_PAIN_STRENGTH=0.25   # 痛点强度：用户有多难受
# WEIGHT_MENTION_VOLUME=0.20  # 提及量：多少人在说（兼作置信度）
# WEIGHT_GROWTH_TREND=0.20    # 增长趋势：抱怨在变多还是变少
# WEIGHT_COMPETITOR_GAP=0.25  # 竞品空白度：有没有人在做
# WEIGHT_FEASIBILITY=0.10     # 实现难度取倒数：个人能不能做

# ==================== 限额 ====================
# 单次分析的笔记数上限（开源版额度）
MAX_NOTES=100
# 每篇笔记最多采集的评论数
MAX_COMMENTS_PER_NOTE=20
# 痛点聚类的最小簇大小。设得过小会产生大量碎片化痛点
MIN_CLUSTER_SIZE=3

# ==================== 路径 ====================
# 默认输出到当前目录
# OUTPUT_DIR=/absolute/path/to/output
# 本地数据库（保存运行历史与 VLM 结果缓存）
# DB_PATH=~/.xhs-pain-miner/db.sqlite

# ==================== 隐私 ====================
# 是否参与社区众包（上传脱敏结论，用于生成行业机会基线）
# 默认关闭。原文、UID、昵称、头像在任何情况下都不会被上传
SHARE_RESULTS=false

# 本地哈希盐值，增强 UID 哈希的不可逆性
# 注意：修改该值会让历史数据的哈希失效，无法跨运行去重
# HASH_SALT=
